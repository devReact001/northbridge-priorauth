ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
DATABASE_URL=postgresql://priorauth:priorauth@localhost:5432/priorauth

# Optional. Defaults shown.
# RETRIEVAL_MODE=hybrid_w3_rerank   # or vector_rerank, vector (see docs/retrieval-experiments.md)
# EHR_ENABLED=true                  # chart lookup through the read-only FHIR MCP server
# FHIR_SOURCE=bundle                # bundle = synthetic files, http = a FHIR REST API (set FHIR_BASE_URL)
# OUTBOUND_ENABLED=true             # send approved documents out through the write-side MCP server
# API_KEY=                         # if set, the API requires an X-API-Key header (the UI proxy sends it from frontend/.env.local)
# CHECKPOINTER=postgres             # keep paused cases across API restarts
# Week 6: speed (see docs/latency-and-models.md; measure with scripts/compare_models.py before turning on)
# INTAKE_MODEL=                     # a different model for one step; empty = ANTHROPIC_MODEL
# EHR_MODEL=
# ASSESS_MODEL=
# DRAFT_MODEL=
# ASSESS_LEAN=false                 # the criteria step writes a shorter form (fewer output tokens)
# ASSESS_SPLIT=false                # pathways and general requirements in two parallel calls
# WARMUP_ON_START=false            # load the retrieval models at startup and report /ready only when done (set in Kubernetes)
